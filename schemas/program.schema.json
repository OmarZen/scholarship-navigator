      "title": "Parent Scholarship",
      "type": "string"
    },
    "website": {
      "title": "Website",
      "type": "string"
    },
    "fields": {
      "items": {
        "type": "string"
      },
      "title": "Fields",
      "type": "array"
    },
    "field_groups": {
      "items": {
        "type": "string"
      },
      "title": "Field Groups",
      "type": "array"
    },
    "degrees": {
      "items": {
        "enum": [
          "Bachelor",
