          "default": null,
          "title": "Source"
        },
        "verified_on": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified On"
        }
      },
      "title": "NationalityRule",
      "type": "object"
    },
    "University": {
