    "DeadlineEstimate": {
      "properties": {
        "month": {
          "title": "Month",
          "type": "integer"
        },
        "day": {
          "title": "Day",
          "type": "integer"
        },
        "years_before_intake": {
          "default": 0,
          "title": "Years Before Intake",
          "type": "integer"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "precision": {
          "default": "approx",
          "enum": [
            "exact",
            "approx",
            "varies"
          ],
          "title": "Precision",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "verified_on": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified On"
        },
        "known_dates": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Intake year -> published ISO date",
          "title": "Known Dates",
          "type": "object"
        },
        "extra": {
          "description": "Other dates in the same cycle (priority rounds, second steps)",
          "items": {
            "$ref": "#/$defs/DeadlinePattern"
          },
          "title": "Extra",
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "month",
        "day"
      ],
      "title": "DeadlineEstimate",
      "type": "object"
    },
    "DeadlinePattern": {
      "properties": {
        "month": {
          "title": "Month",
          "type": "integer"
        },
        "day": {
          "title": "Day",
          "type": "integer"
        },
        "years_before_intake": {
          "default": 0,
          "title": "Years Before Intake",
          "type": "integer"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
